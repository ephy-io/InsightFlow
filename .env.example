# 复制为本机 .env 后填写百炼密钥。密钥、模型和端点须对应同一地域。
DASHSCOPE_API_KEY=

# 默认模型与演示配置一致。
DASHSCOPE_CHAT_MODEL=qwen3.7-plus
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
DASHSCOPE_RERANK_MODEL=qwen3-rerank

# Chat 和 Embedding 共用兼容接口，Reranker 使用独立端点。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
