FROM python:3.11-slim

# 设置工作目录
WORKDIR /app

# 安装数据分析常用的 Python 库
RUN pip install --no-cache-dir \
    pandas \
    numpy \
    matplotlib \
    seaborn \
    requests \
    json5

# 创建用于执行代码的目录
RUN mkdir -p /app/code

# 使用非 root 用户运行执行器
RUN useradd -m -u 1000 executor
USER executor

# 设置容器默认命令
CMD ["python3"]